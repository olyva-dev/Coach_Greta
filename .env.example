# Copy to .env.local for development. All three are safe to expose to the
# browser; no privileged key ever lives in the Next.js app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<from scripts/generate-vapid-keys.mjs>
